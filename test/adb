#!/usr/bin/env bash
# Fake adb for dry-run testing of setup.sh
# Simulates a OnePlus 15R (CPH2769) with the missing config

case "$*" in
    "devices")
        echo "List of devices attached"
        echo "ABCDEF1234	device"
        ;;
    "wait-for-device")
        sleep 0.5
        ;;
    "pair"*)
        echo "Successfully paired to $(echo "$@" | awk '{print $2}')"
        ;;
    "connect"*)
        echo "connected to $(echo "$@" | awk '{print $2}')"
        ;;
    *"getprop ro.build.product"*)
        echo "CPH2769"
        ;;
    *"getprop ro.product.model"*)
        echo "CPH2769"
        ;;
    *"[ -f"*"silicon_x25"*"echo EXISTS"*)
        # verify mode: file present after fix
        echo "EXISTS"
        ;;
    *"[ -f"*"silicon_x25"*)
        # file is missing = the bug
        exit 1
        ;;
    *"ls -la /odm/firmware/fastchg/24877"*)
        echo "total 24"
        echo "-r--r--r-- 1 root root 8192 2026-01-15 00:00 charging_hyper_mode_config.txt"
        echo "-r--r--r-- 1 root root 4096 2026-01-15 00:00 fast_charging_config.txt"
        echo "-r--r--r-- 1 root root 2048 2026-01-15 00:00 normal_charging_config.txt"
        ;;
    *"settings get global oplus_customize_system_stable_plan_switch"*)
        echo "1"
        ;;
    *"settings put global"*)
        echo ""
        ;;
    "push"*)
        FILE=$(echo "$@" | awk '{print $2}')
        echo "$(basename "$FILE"): 1 file pushed, 0 skipped. 0.1 MB/s (1215 bytes in 0.012s)"
        ;;
    *"chmod"*)
        ;;
    *"pm list packages"*)
        echo "package:com.kpgc10kai.timerroot"
        echo "package:me.weishu.kernelsu"
        echo "package:moe.shizuku.privileged.api"
        ;;
    *"pm path moe.shizuku"*)
        echo "package:/data/app/~~abc123/moe.shizuku.privileged.api-def456==/base.apk"
        ;;
    *"app_process"*)
        echo "[shizuku] server started"
        ;;
    *"atrace"*)
        echo "capturing trace..."
        ;;
    *"dumpsys battery"*)
        echo "Current Battery Service state:"
        echo "  AC powered: true"
        echo "  USB powered: false"
        echo "  Wireless powered: false"
        echo "  Max charging current: 8000000"
        echo "  Max charging voltage: 10000000"
        echo "  Charge type: 3"
        echo "  status: 2"
        echo "  health: 2"
        echo "  present: true"
        echo "  level: 45"
        echo "  voltage: 3850"
        echo "  temperature: 310"
        echo "  technology: Li-poly"
        echo "  Charger voltage: 10000"
        ;;
    *)
        echo "[fake-adb] unhandled: $*" >&2
        ;;
esac
exit 0
